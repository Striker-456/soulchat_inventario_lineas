# Copia este archivo a ".env" (mismo directorio) y rellena los valores reales.
# ".env" NO se sube al repo (ver .gitignore) — son secretos por dispositivo.

# ── Base de datos ─────────────────────────────────────────────────────────
POSTGRES_DB=soulchat_inventario
POSTGRES_USER=soulchat
POSTGRES_PASSWORD=

# ── Backend (.NET) ───────────────────────────────────────────────────────
# Cadena aleatoria larga (40+ caracteres) para firmar los JWT.
# Generar en PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($b); [Convert]::ToBase64String($b)
# Generar en bash/mac/linux:
#   openssl rand -base64 32
JWT_KEY=

# Debe representar EXACTAMENTE 32 bytes en base64 (AES-256). Mismo comando de
# arriba sirve para generarla. Si migras un ".env" existente, usa la misma
# clave que ya tenías o las credenciales cifradas en la base quedan
# ilegibles.
ENCRYPTION_KEY=

# Con "Production" (el default aquí) la API NO intenta auto-migrar al
# arrancar (ese código solo corre en Development) — las migraciones las
# aplica el servicio "migrate" de docker-compose antes de que la API levante.
# Nota: Swagger UI queda expuesto igual en ambos entornos (así está el
# código hoy); no lo trates como algo exclusivo de Development.
# ASPNETCORE_ENVIRONMENT=Production

# ── Puertos publicados en el host ────────────────────────────────────────
# FRONTEND_PORT=8080
# API_PORT=5095
