# Base URL de la API que usa el navegador.
# Por defecto "/api": Vite lo reenvía a VITE_DEV_API_TARGET en desarrollo.
# En producción apunta a la URL real de la API, p. ej. https://api.midominio.com
# VITE_API_URL=/api

# Dónde corre la API .NET en desarrollo (solo lo usa el proxy de Vite).
# VITE_DEV_API_TARGET=http://localhost:5095
